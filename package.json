{
  "name": "tree-sitter-scss",
  "version": "0.10.0",
  "private": true,
  "description": "Shared CSS and SCSS grammar for tree-sitter",
  "main": "bindings/node",
  "scripts": {
    "install": "node-gyp-build",
    "generate": "node scripts/grammar.js",
    "build": "node scripts/grammar.js --build",
    "parse": "node scripts/grammar.js parse examples/highlight-stress.scss",
    "highlight": "node scripts/grammar.js highlight examples/highlight-stress.scss",
    "test": "pnpm generate && pnpm build && pnpm test:parser && pnpm test:node && pnpm test:development",
    "lint": "eslint grammar.js eslint.config.js bindings/node/*.js scripts/*.js",
    "format": "prettier --write \"**/*.js\" \"*.json\" \"*.yaml\" \"*.md\" \".github/workflows/*.yml\" \"scripts/*.json\" \"scripts/*.css\" \"test/config.json\"",
    "check:generated": "node scripts/grammar.js --check",
    "test:parser": "node scripts/grammar.js test",
    "test:node": "node --test --test-concurrency=1 bindings/node/*_test.js",
    "test:development": "node --test --test-concurrency=1 scripts/*_test.js",
    "test:rust": "cargo test",
    "benchmark": "pnpm build && node --expose-gc scripts/benchmark.js",
    "check": "pnpm lint && pnpm format:check && pnpm check:generated && pnpm build && pnpm test:parser && pnpm test:node && pnpm test:development && pnpm test:rust && cargo fmt --check && pnpm check:package && pnpm preview:export",
    "preview": "node scripts/preview.js --serve",
    "preview:export": "node scripts/preview.js",
    "dev": "node scripts/preview.js --watch",
    "format:check": "prettier --check \"**/*.js\" \"*.json\" \"*.yaml\" \"*.md\" \".github/workflows/*.yml\" \"scripts/*.json\" \"scripts/*.css\" \"test/config.json\"",
    "check:package": "node scripts/check-package.js"
  },
  "keywords": [
    "tree-sitter",
    "css",
    "scss",
    "parser",
    "syntax-highlighting"
  ],
  "author": "P233",
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "node-gyp": "12.2.0",
    "prettier": "3.9.9",
    "tree-sitter": "0.25.1",
    "tree-sitter-cli": "0.27.0"
  },
  "repository": "github:P233/tree-sitter-scss",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "bindings/node/index.js",
    "bindings/node/binding.cc",
    "queries",
    "src"
  ],
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  }
}
